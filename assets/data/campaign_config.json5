    {
      // 国家编号，必须与地图和英雄数据中的可用国家编号一致。
      "id": 0,
      // 国家显示名称。
      "name": "阿尔马",
      // 开局国库金币。
      "initialGold": 80,
      // 每月固定保底收入。
      "monthlyBaseIncome": 10
